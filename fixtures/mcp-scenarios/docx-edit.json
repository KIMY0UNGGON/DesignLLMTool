{
  "task": "docx-edit",
  "summary": "Open the shared DOCX fixture, insert text at the start of its first paragraph, insert a new heading paragraph before the body, render the first page and export a PDF.",
  "steps": [
    { "id": "workspace", "tool": "workspace_list", "arguments": {}, "bind": { "workspace_id": "/structuredContent/workspace_id" } },
    { "id": "open", "tool": "artifact_open", "arguments": { "request_id": "$request_id", "actor": "scenario", "path": "$fixture:docx.basic-preserve", "kind": "docx" }, "bind": { "artifact": "/structuredContent/id", "revision": "/structuredContent/revision" } },
    { "id": "view0", "tool": "artifact_inspect", "arguments": { "artifact_id": "$artifact" }, "save": "view0" },
    { "select": { "from": "view0", "pointer": "/structuredContent/body/document/sections", "where": { "has_key": ["runs"] }, "field": "id" }, "as": "first_paragraph" },
    { "select": { "from": "view0", "pointer": "/structuredContent/body/document/sections", "where": { "has_key": ["runs"] }, "field": "@text" }, "as": "paragraph_before" },
    { "select": { "from": "view0", "pointer": "/structuredContent/body/document/sections", "where": { "has_key": ["blocks"] }, "field": "id" }, "as": "section" },
    { "id": "insert_text", "tool": "changes_apply", "arguments": {
        "request_id": "$request_id", "actor": "scenario", "workspace_id": "$workspace_id", "artifact_id": "$artifact", "base_revision": "$revision",
        "allowed_intents": ["content"], "job_ref": null, "read_dependencies": [],
        "operations": [ { "op": "replace_text", "range": { "paragraph_id": "$first_paragraph", "start": 0, "end": 0 }, "text": "P0 " } ]
      }, "bind": { "revision": "/structuredContent/revision" } },
    { "id": "insert_heading", "tool": "changes_apply", "arguments": {
        "request_id": "$request_id", "actor": "scenario", "workspace_id": "$workspace_id", "artifact_id": "$artifact", "base_revision": "$revision",
        "allowed_intents": ["content"], "job_ref": null, "read_dependencies": [],
        "operations": [ { "op": "insert_flow_block", "section_id": "$section", "index": 0, "block": { "type": "paragraph", "value": {
            "id": "scenario-heading", "runs": [ { "id": "scenario-heading-run", "text": "Scenario heading", "style": { "font_family": "Pretendard", "font_size": 254000, "color": "#1F2A44", "fill": "#FFFFFF", "stroke": "#566479", "stroke_width": 12700, "bold": true, "italic": false, "align": "left" }, "protected": false } ],
            "style_ref": null, "format": { "align": "left", "space_before": 0, "space_after": 76200, "line_spacing": 228600, "indent": 0 }
          } } } ]
      }, "bind": { "revision": "/structuredContent/revision" } },
    { "id": "export_pdf_refused", "tool": "artifact_export", "arguments": {
        "request_id": "$request_id", "options": { "artifact_id": "$artifact", "expected_revision": "$revision", "format": "pdf", "required_editability": "none", "allowed_losses": [], "profile": { "dpi": 96, "transparent": false }, "page_indices": null },
        "target_path": "$scratch/refused.pdf", "overwrite": false, "expected_target_hash": null
      }, "expect": { "is_error": true, "code": "EXPORT_LOSS_REQUIRED" } },
    { "id": "export_pdf", "tool": "artifact_export", "arguments": {
        "request_id": "$request_id", "options": { "artifact_id": "$artifact", "expected_revision": "$revision", "format": "pdf", "required_editability": "none", "allowed_losses": ["docx.header_footer_not_rendered"], "profile": { "dpi": 96, "transparent": false }, "page_indices": null },
        "target_path": "$scratch/edited.pdf", "overwrite": false, "expected_target_hash": null
      } },
    { "id": "final", "tool": "artifact_inspect", "arguments": { "artifact_id": "$artifact" }, "save": "final" },
    { "select": { "from": "final", "pointer": "/structuredContent/body/document/sections", "where": { "key_equals": { "id": "$first_paragraph" } }, "field": "@text" }, "as": "paragraph_after" }
  ],
  "checks": [
    { "check": "text_present", "text": "Scenario heading" },
    { "check": "text_prefix", "before": "paragraph_before", "after": "paragraph_after", "text": "P0 " },
    { "check": "render", "page": 0 },
    { "check": "file", "path": "$scratch/edited.pdf", "magic": "%PDF-" },
    { "check": "absent", "path": "$scratch/refused.pdf" }
  ]
}
